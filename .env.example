# Binance TESTNET API-Zugangsdaten
# WICHTIG: Diese Datei zu ".env" umbenennen/kopieren und mit deinen echten
# Testnet-Keys füllen. Die ".env" darf NIEMALS in Git eingecheckt werden.
#
# Testnet-Keys bekommst du hier (kostenlos, kein echtes Geld):
# https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Sicherheitsschalter: Muss "true" sein, damit der Bot überhaupt Orders
# platzieren darf. So verhinderst du versehentliche Trades.
DCA_BOT_ENABLE_TRADING=false

# Optionale Kapital-Allocator-Anbindung (siehe weiter unten) - leer/
# auskommentiert lassen, um unverändert 100% des obigen Betrags pro Kauf
# zu nutzen.
#DCA_ALLOCATOR_STATE_FILE=data/allocator_state.json

# Telegram-Benachrichtigungen (optional - leer lassen zum Deaktivieren).
# Bot-Token von @BotFather bekommen, Chat-ID z.B. über @userinfobot oder
# https://api.telegram.org/bot<TOKEN>/getUpdates herausfinden.
TELEGRAM_BOT_TOKEN=dein_telegram_bot_token
TELEGRAM_CHAT_ID=deine_telegram_chat_id

# --- Spot-Grid-Trading-Bot (dca_bot/main_grid.py) ---
# Komplett eigenständig vom DCA-Bot oben - eigener Zustand, eigener Notaus.
# Nutzt dieselben BINANCE_/TELEGRAM_-Zugangsdaten von oben.
GRID_SYMBOL=BTCUSDT
GRID_LOWER_LIMIT=70000.0
GRID_UPPER_LIMIT=90000.0
GRID_SPACING_PCT=1.5
GRID_AMOUNT_PER_LEVEL=15.0
GRID_INTERVAL_MINUTES=5
GRID_BOT_ENABLE_TRADING=false
GRID_KILL_SWITCH_FILE=STOP_GRID
GRID_BOT_HALT=false
GRID_STOP_LOSS_PCT=15.0
GRID_STATE_FILE=data/grid_positions.json
GRID_STOP_LOSS_STATE_FILE=data/grid_stop_loss_paused.json

# --- Trend-Following-Bot (dca_bot/main_trend.py) ---
# Komplett eigenständig von DCA und Grid - eigener Zustand, eigener Notaus.
# Nutzt dieselben BINANCE_/TELEGRAM_-Zugangsdaten von oben. Defaults
# entsprechen den im Backtest getesteten Werten (trend_backtest.py) -
# nicht ohne erneuten Backtest ändern.
TREND_SYMBOL=BTCUSDT
TREND_EMA_FAST_PERIOD=20
TREND_EMA_SLOW_PERIOD=50
TREND_MIN_GAP_PCT=1.0
TREND_AMOUNT_PER_TRADE=15.0
TREND_INTERVAL_HOURS=24
TREND_BOT_ENABLE_TRADING=false
TREND_KILL_SWITCH_FILE=STOP_TREND
TREND_BOT_HALT=false
TREND_STOP_LOSS_PCT=10.0
TREND_STATE_FILE=data/trend_ledger.json
TREND_STOP_LOSS_STATE_FILE=data/trend_stop_loss_paused.json

# Optionale Kapital-Allocator-Anbindung (siehe unten) - leer/auskommentiert
# lassen, um unverändert 100% des obigen Betrags pro Trade zu nutzen.
#TREND_ALLOCATOR_STATE_FILE=data/allocator_state.json

# --- Kapital-Allocator (dca_bot/main_allocator.py) ---
# Komplett eigenständig von DCA/Grid/Trend - eigener Zustand, eigener
# Notaus. Platziert selbst NIE Orders, sondern berechnet nur eine
# stufenlose Kapitalzuteilung zwischen DCA und Trend-Following je nach
# aktueller Trendstärke (EMA-Abstand) und schreibt sie in ALLOCATOR_STATE_FILE.
# Wirkt sich auf DCA/Trend nur aus, wenn DCA_ALLOCATOR_STATE_FILE bzw.
# TREND_ALLOCATOR_STATE_FILE oben/unten explizit auf denselben Pfad gesetzt
# werden - beide bleiben ohne diese Einstellung komplett unverändert.
ALLOCATOR_SYMBOL=BTCUSDT
ALLOCATOR_EMA_FAST_PERIOD=20
ALLOCATOR_EMA_SLOW_PERIOD=50
ALLOCATOR_ZERO_ANCHOR_PCT=0.0
ALLOCATOR_FULL_ANCHOR_PCT=3.0
ALLOCATOR_SMOOTHING_PERIOD=24
ALLOCATOR_INTERVAL_MINUTES=60
ALLOCATOR_NOTIFY_THRESHOLD_PP=15.0
ALLOCATOR_KILL_SWITCH_FILE=STOP_ALLOCATOR
ALLOCATOR_HALT=false
ALLOCATOR_STATE_FILE=data/allocator_state.json